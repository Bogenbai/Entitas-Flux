<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTestTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!--
    The Unity-free parts of the editor integration, compiled straight from their sources so
    the tests need neither UnityEditor.dll nor a running editor.
  -->
  <ItemGroup>
    <Compile Include="..\src\Generation\GenerationScheduler.cs" Link="GenerationScheduler.cs" />
    <Compile Include="..\src\Generation\GenerationSettings.cs" Link="GenerationSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="6.7.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.3.1" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
  </ItemGroup>

</Project>
