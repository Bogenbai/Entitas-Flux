<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <!--
      Put DesperateDevs.Unity.Editor.dll in the build output so build.sh can ship it: this
      assembly (and the visual-debugging editor one) reference it, and without it Unity
      refuses to load them in any project that does not still carry a copy from the
      original Entitas distribution.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DesperateDevs.Unity.Editor" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Entitas\src\Entitas.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(UnityEditor)" />
    <Reference Include="$(UnityEngine)" />
    <Reference Include="UnityEditor">
      <HintPath>..\..\..\UnityEditor.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\..\UnityEngine.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
