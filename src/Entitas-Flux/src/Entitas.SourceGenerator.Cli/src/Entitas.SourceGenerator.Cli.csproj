<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone, Jenny-style CLI that writes the Entitas-Flux generated code to disk as
    real .cs files. It reuses the source-generator engine (Entitas.SourceGenerator) by
    building a faithful Roslyn Compilation from a Unity-generated Assembly-CSharp.csproj
    and calling EntitasGenerators.Generate(compilation). For consumers that want
    committed/debuggable generated files instead of the compile-time analyzer.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>entitas-gen</AssemblyName>
    <RootNamespace>Entitas.SourceGenerator.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Entitas.SourceGenerator\src\Entitas.SourceGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" />
  </ItemGroup>

</Project>
