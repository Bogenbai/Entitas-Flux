<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone, Jenny-style CLI that writes the Entitas-Flux generated code to disk as
    real .cs files. It reuses the source-generator engine (Entitas.SourceGenerator) by
    building a faithful Roslyn Compilation from a Unity-generated Assembly-CSharp.csproj
    and calling EntitasGenerators.Generate(compilation). For consumers that want
    committed/debuggable generated files instead of the compile-time analyzer.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>entitas-gen</AssemblyName>
    <RootNamespace>Entitas.SourceGenerator.Cli</RootNamespace>
    <!--
      Runs on whatever .NET is there, 6 or newer: the Unity editor ships .NET 6 and runs
      the copy bundled in the package with it, while a terminal may only have .NET 8 or 10,
      where a plain net6.0 app refuses to start ("You must install or update .NET").
    -->
    <RollForward>LatestMajor</RollForward>
    <!-- Launched as `dotnet entitas-*.dll`; a native launcher would tie the package to one OS. -->
    <UseAppHost>false</UseAppHost>
    <!--
      Every run is a cold start (the editor launches a fresh process per regeneration), so
      tune for start-up: quick-JIT methods with loops, skip tiered PGO's instrumentation,
      and a non-concurrent GC. Measured on a 1933-file project: 0.95 s -> 0.75 s.
    -->
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <TieredPGO>false</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Entitas.SourceGenerator\src\Entitas.SourceGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" />
  </ItemGroup>

</Project>
