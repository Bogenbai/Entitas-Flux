<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Roslyn Incremental Source Generator for Entitas-Flux.
    Must target netstandard2.0 and reference only Microsoft.CodeAnalysis.CSharp
    (no Workspaces/MSBuild) so the analyzer DLL loads inside the Unity 2022.3
    compiler (Roslyn 4.x) as well as in dotnet/IDE builds.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Analyzers ship in the analyzer folder, not as a normal lib dependency. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Pack the generator DLL into the analyzer path so consumers pick it up. -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
